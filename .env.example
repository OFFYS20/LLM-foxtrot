# ============================================================================
# Foxtrot — example environment configuration
# Copy to `.env` (backend) and `frontend/.env.local` (frontend) as needed.
# ============================================================================

# ---------------------------------------------------------------- backend ---
# SQLite by default; swap for PostgreSQL without touching application code:
#   FOXTROT_DATABASE_URL=postgresql+psycopg://foxtrot:foxtrot@localhost:5432/foxtrot
FOXTROT_DATABASE_URL=sqlite:///./data/foxtrot.db

# Root directory for models, datasets, checkpoints and uploads.
# All user-supplied paths are resolved *inside* this root (no path traversal).
FOXTROT_DATA_DIR=./data

FOXTROT_HOST=0.0.0.0
FOXTROT_PORT=8000
FOXTROT_LOG_LEVEL=info

# Demo mode: seeds simulated models/datasets/experiments/benchmarks and enables
# the simulated training + inference backends. Everything produced this way is
# flagged `simulated: true` in the API and badged "DEMO" in the UI.
FOXTROT_DEMO_MODE=true
FOXTROT_SEED_DEMO_DATA=true

# Inference engine: demo | transformers | llamacpp | vllm | ollama
FOXTROT_INFERENCE_ENGINE=demo
FOXTROT_OLLAMA_BASE_URL=http://localhost:11434

# Hardware telemetry: auto | nvml | simulated
FOXTROT_HARDWARE_PROVIDER=auto

# Comma-separated CORS origins for the frontend
FOXTROT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upload limits
FOXTROT_MAX_UPLOAD_MB=512

# Optional Hugging Face token for private repos (never logged)
# HF_TOKEN=

# --------------------------------------------------------------- frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
# http = talk to the FastAPI backend, mock = fully client-side demo fixtures
NEXT_PUBLIC_DATA_PROVIDER=http
